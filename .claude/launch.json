{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trainready",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "taper-animated",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--directory",
        "animated-sites/taper"
      ],
      "port": 8080
    },
    {
      "name": "taper-mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "cwd": "mobile",
      "port": 8082
    }
  ]
}